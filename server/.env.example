# Server Environment Configuration
NODE_ENV=development
PORT=5000

# MongoDB Configuration (Atlas Cloud)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=smartqueue

# JWT Authentication
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_chars_long
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_chars_long
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Client URL (for CORS and reset links)
CLIENT_URL=http://localhost:5173

# Email / SMTP Configuration (Console/Mock transport used in dev if SMTP is not configured)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
MAIL_FROM="SmartQueue System" <no-reply@smartqueue.com>

# Storage Configuration (local or s3)
STORAGE_DRIVER=local
S3_BUCKET=
S3_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Optional Redis Configuration (for horizontal Socket.IO scaling)
REDIS_URL=
